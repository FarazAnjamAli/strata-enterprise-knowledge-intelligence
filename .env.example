# =====================================================================
#  Strata configuration
#  Copy to .env (or run scripts/setup.ps1 / scripts/setup.sh, which
#  generates every secret for you). Never commit the real .env.
# =====================================================================

# ---------------------------------------------------------------- app
APP_NAME=Strata
# development | staging | production
ENVIRONMENT=production
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
WEB_PORT=3000
DEPARTMENTS=Engineering,Finance,Human Resources,Legal,Marketing,Operations,Sales,Support

# ---------------------------------------------------------------- secrets
POSTGRES_USER=strata
POSTGRES_DB=strata
POSTGRES_PASSWORD=change-me-hex-only
REDIS_PASSWORD=change-me-hex-only
# >= 32 random characters
JWT_SECRET=change-me-to-a-long-random-string
# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Comma-separate keys (newest first) to rotate.
FILE_ENCRYPTION_KEY=

# ---------------------------------------------------------------- auth
# local (on-prem, default) | supabase
AUTH_PROVIDER=local
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_MIN_LENGTH=12
# true once served over HTTPS
COOKIE_SECURE=false
# First admin, created on first start if the user table is empty
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change-Me-Now-2026!

# Only when AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------- LLM routing
# Tried in this order; a tier that fails is skipped for LLM_CIRCUIT_COOLDOWN s.
LLM_TIER_ORDER=local,free,paid
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_CIRCUIT_COOLDOWN=30
# external tiers are ALWAYS masked
MASK_LOCAL_LLM=false

# Tier 1 - local model (Ollama)
LOCAL_LLM_ENABLED=true
# container (compose profile local-llm):  http://ollama:11434
# native Ollama on the host:              http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096

# Tier 2 - free / low-cost API (any OpenAI-compatible endpoint)
FREE_LLM_ENABLED=false
FREE_LLM_LABEL=Groq
FREE_LLM_BASE_URL=https://api.groq.com/openai/v1
FREE_LLM_API_KEY=
FREE_LLM_MODEL=llama-3.3-70b-versatile

# Tier 3 - paid premium API
PAID_LLM_ENABLED=false
# openai | anthropic | openai_compatible
PAID_LLM_PROVIDER=openai
PAID_LLM_BASE_URL=https://api.openai.com/v1
PAID_LLM_API_KEY=
PAID_LLM_MODEL=gpt-4o-mini
PAID_LLM_INPUT_COST_PER_MTOK=0.15
PAID_LLM_OUTPUT_COST_PER_MTOK=0.60
PAID_LLM_MONTHLY_BUDGET_USD=50
PAID_LLM_REQUIRE_CONFIRMATION=true
# e.g. Admin,Department Head  (empty = everyone)
PAID_LLM_ALLOWED_ROLES=

# ---------------------------------------------------------------- retrieval
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
ENABLE_RERANKING=true
TOP_K_RESULTS=10
CONTEXT_CHUNKS=5

# ---------------------------------------------------------------- files
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=pdf,docx,xlsx,csv,txt,md,json,xml,png,jpg,jpeg,mp4,mov,avi,mkv
ENABLE_OCR=true
OCR_LANGUAGE=eng

# ---------------------------------------------------------------- security
ENABLE_RBAC=true
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_FINANCIAL_MASKING=true
FINANCIAL_MASKING_PATTERNS=salary,revenue,cost,budget,profit,amount,price,payment
RATE_LIMIT_ADMIN=100
RATE_LIMIT_DEPARTMENT_HEAD=50
RATE_LIMIT_MANAGER=30
RATE_LIMIT_MEMBER=10

# ---------------------------------------------------------------- workers
API_WORKERS=2
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------- optional
# Diagram generation (/image) - sends the prompt to Google, off by default
IMAGE_GENERATION_ENABLED=false
GEMINI_API_KEY=
# Outbound events (n8n, Zapier, ...). Signed with HMAC-SHA256 when a secret is set.
WEBHOOK_URL=
WEBHOOK_SECRET=
